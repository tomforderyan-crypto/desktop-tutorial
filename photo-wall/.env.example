# Copy to .env.local for local development. In GitHub, set these as
# repository variables (Settings → Secrets and variables → Actions → Variables).
# Both values are safe to publish: the database rules in supabase/setup.sql
# decide what the key can do.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_KEY=your-publishable-or-anon-key
