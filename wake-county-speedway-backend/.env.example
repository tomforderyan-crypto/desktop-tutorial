# Copy to .env for local dev. All of these are optional individually —
# each feature degrades gracefully (see server.ts / routes) when its own
# vars are missing, so you can bring these up one at a time.

PORT=4000

# Shared secret staff use to PUT banner-ads / food-vendors / social-accounts /
# livestream-link.
ADMIN_API_KEY=change-me

# Stripe — powers /checkout/*. Required for the merch checkout flow to work;
# there is no server-side mock for this one since a payment endpoint with a
# fake success path is a bad thing to leave lying around.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
